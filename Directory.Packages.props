<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!--
    Version Pinning (see .github/copilot-instructions.md):
    This release targets Windows 10 and .NET 10. Packages whose major version tracks the
    .NET release wave (Microsoft.Extensions.*, System.*, Microsoft.EntityFrameworkCore.*,
    Microsoft.Windows.Compatibility) are capped at 10.x. Do not raise them to 11.x.
  -->
  <!-- Microsoft.Agents packages -->
  <ItemGroup>
    <PackageVersion Include="ErikEJ.EntityFrameworkCore.DgmlBuilder" Version="6.0.0" />
    <PackageVersion Include="Json.Net" Version="1.0.33" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Abstractions" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Harness" Version="1.28.0" />
    <!-- Held at 1.27.0: no stable release published on nuget.org (alpha builds only). -->
    <PackageVersion Include="Microsoft.Agents.AI.Mcp" Version="1.27.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows.Generators" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="8.0.0-preview1.26313.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.92.0" />
    <PackageVersion Include="Microsoft.Identity.Client.Broker" Version="4.92.0" />
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.92.0" />
    <!-- Held at 3.0.0: 4.0.0 ships a .NET Framework-only assembly (NU1701 on net10.0-windows). -->
    <PackageVersion Include="Microsoft.Management.Infrastructure" Version="3.0.0" />
    <PackageVersion Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageVersion Include="Microsoft.Windows.Compatibility" Version="10.0.15" />
    <!-- Held at 10.0.22621.x: later builds track the Windows 11 SDK, outside the Windows 10 target. -->
    <PackageVersion Include="Microsoft.Windows.SDK.Contracts" Version="10.0.22621.3233" />
    <PackageVersion Include="Microsoft.Windows.SDK.Ref" Version="10.0.22621.3233" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.4.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="14.0.1-beta2" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.21.0" />
    <PackageVersion Include="System.Diagnostics.PerformanceCounter" Version="10.0.15" />
    <PackageVersion Include="System.DirectoryServices" Version="10.0.15" />
    <PackageVersion Include="System.DirectoryServices.AccountManagement" Version="10.0.15" />
    <PackageVersion Include="System.Management.Automation" Version="7.4.6" />
    <PackageVersion Include="TaskScheduler" Version="2.12.2" />
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
  </ItemGroup>
  <!-- Microsoft.Extensions packages -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.15" />
  </ItemGroup>
  <!-- UI / MVVM -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="MahApps.Metro" Version="2.4.11" />
    <PackageVersion Include="MarkdownViewer.Wpf" Version="2.0.4368" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <!-- Held at 10.0.11: not published on nuget.org (preview feed only). -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer.Vector" Version="10.0.11" />
    <PackageVersion Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
  </ItemGroup>
  <!-- Test packages -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.3" />
    <PackageVersion Include="MSTest" Version="4.5.3" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
  </ItemGroup>
  <!-- Other packages -->
  <ItemGroup>
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <PackageVersion Include="OllamaSharp" Version="5.5.2" />
    <PackageVersion Include="Jetbrains.Annotations" Version="2026.2.0" />
    <PackageVersion Include="OpenAI" Version="2.15.0" />
    <PackageVersion Include="System.Management" Version="10.0.15" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.15" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.15" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <!-- Held at 1.0.0: not published on nuget.org. -->
    <PackageVersion Include="ColorJsonProvider" Version="1.0.0" />
  </ItemGroup>
</Project>
