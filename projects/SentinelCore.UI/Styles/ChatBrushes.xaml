<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====== Chat Color Palette ====== -->
    <SolidColorBrush x:Key="ChatBackground" Color="#0D1117" />
    <SolidColorBrush x:Key="ChatSurface" Color="#161B22" />
    <SolidColorBrush x:Key="ChatSurface2" Color="#21262D" />
    <SolidColorBrush x:Key="ChatBorder" Color="#30363D" />
    <SolidColorBrush x:Key="ChatTextPrimary" Color="#E6EDF3" />
    <SolidColorBrush x:Key="ChatTextMuted" Color="#8B949E" />
    <SolidColorBrush x:Key="ChatAccent" Color="#8B5CF6" />
    <SolidColorBrush x:Key="ChatAccentHover" Color="#7C3AED" />
    <SolidColorBrush x:Key="ChatAccentPressed" Color="#6D28D9" />
    <SolidColorBrush x:Key="ChatUserBubble" Color="#2D3B9E" />
    <SolidColorBrush x:Key="ChatDanger" Color="#F87171" />
    <SolidColorBrush x:Key="ChatDangerHover" Color="#3F1515" />
    <SolidColorBrush x:Key="ChatDangerPressed" Color="#5A1E1E" />
    <SolidColorBrush x:Key="ChatDisabled" Color="#4B5563" />
    <SolidColorBrush x:Key="ChatTextDark" Color="#212620" />

</ResourceDictionary>