<Page
    x:Class="SentinelCore.UI.Views.CreateCasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="900"
    Background="{DynamicResource ChatBackground}"
    FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="700" HorizontalAlignment="Left" Margin="32,28,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Page Title -->
            <TextBlock
                Grid.Row="0"
                Style="{StaticResource PageTitleText}"
                Text="Create Case" />

            <!-- Form -->
            <StackPanel Grid.Row="1">
                <TextBlock
                    Style="{StaticResource SubtitleText}"
                    Text="Signal Description" />
                <TextBox
                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource FormTextBoxStyle}"
                    MinHeight="90"
                    TextWrapping="Wrap"
                    AcceptsReturn="True" />

                <TextBlock
                    Style="{StaticResource SubtitleText}"
                    Text="Signal Source" />
                <TextBox
                    Text="{Binding SignalSource, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource FormTextBoxStyle}" />

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button
                        Command="{Binding CreateCaseCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Margin="0,0,12,0"
                        Content="Create Case" />
                    <Button
                        Command="{Binding ResetFormCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Reset" />
                </StackPanel>

                <!-- Result message -->
                <TextBlock
                    Margin="0,16,0,0"
                    Style="{StaticResource BodyText}"
                    Text="{Binding ResultMessage}"
                    Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
