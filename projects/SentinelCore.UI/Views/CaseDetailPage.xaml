<Page
    x:Class="SentinelCore.UI.Views.CaseDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="900"
    Background="{DynamicResource ChatBackground}"
    FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="700" HorizontalAlignment="Left" Margin="32,28,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Page Title -->
            <TextBlock
                Grid.Row="0"
                Style="{StaticResource PageTitleText}"
                Text="Case Detail" />

            <!-- Form -->
            <StackPanel Grid.Row="1">
                <TextBlock
                    Style="{StaticResource SubtitleText}"
                    Text="Case ID" />
                <TextBox
                    Text="{Binding CaseIdText, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource FormTextBoxStyle}" />

                <Button
                    Command="{Binding LookupCaseCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,12,0,0"
                    Padding="12,6"
                    HorizontalAlignment="Left"
                    Content="Look Up" />

                <TextBlock
                    Style="{StaticResource BodyText}"
                    Margin="0,10,0,0"
                    Text="{Binding StatusInfo}" />

                <TextBlock
                    Style="{StaticResource SubtitleText}"
                    Text="Advance To Status" />
                <ComboBox
                    ItemsSource="{Binding AvailableStatuses}"
                    SelectedItem="{Binding SelectedTargetStatus}"
                    Style="{StaticResource FormComboBoxStyle}"
                    HorizontalAlignment="Left" />

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button
                        Command="{Binding AdvanceCaseCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Margin="0,0,12,0"
                        Content="Advance Case" />
                    <Button
                        Command="{Binding ClearFormCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Clear" />
                </StackPanel>

                <!-- Result message -->
                <TextBlock
                    Margin="0,16,0,0"
                    Style="{StaticResource BodyText}"
                    Text="{Binding ResultMessage}"
                    Visibility="{Binding ShowResult, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
