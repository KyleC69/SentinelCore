<Window x:Class="SentinelCore.UI.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:markdown="clr-namespace:MarkdownViewer.Wpf;assembly=MarkdownViewer.Wpf"
        xmlns:local="clr-namespace:SentinelCore.UI.Views"
        mc:Ignorable="d"
        Title="SentinelCore - Log Viewer"
        Height="600" Width="900"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ChatBackground}">

    <Window.Resources>
        <local:MarkdownCollectionToStringConverter x:Key="MarkdownJoinConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Log Content Area -->
        <Border Margin="8"
                Background="{DynamicResource ChatSurface}"
                BorderBrush="{DynamicResource ChatBorder}"
                BorderThickness="1"
                CornerRadius="4">
            <markdown:MarkdownView x:Name="MarkdownViewer"
                                   VerticalScrollBarVisibility="Auto"
                                   HorizontalScrollBarVisibility="Auto"
                                   Padding="8"
                                   WordWrap="True"
                                   HorizontalContentAlignment="Left"
                                   Markdown="{Binding MarkdownLogEntries, Converter={StaticResource MarkdownJoinConverter}, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Border>
    </Grid>
</Window>