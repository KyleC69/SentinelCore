<Application x:Class="SentinelCoreHost.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- MarkdownViewer.Wpf does not ship a built-in dark theme despite the README.
                     This project dictionary supplies the base code-block style keys. -->
                <ResourceDictionary Source="themes/MarkdownViewerDarkTheme.xaml" />
                <!-- Project overrides for code-block chrome. -->
                <ResourceDictionary Source="themes/CodeBlocksOverrides.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ── Dark Theme Palette ───────────────────────────────────────── -->
            <SolidColorBrush x:Key="AppBackground" Color="#0D1117" />
            <SolidColorBrush x:Key="AppSurface" Color="#161B22" />
            <SolidColorBrush x:Key="AppSurface2" Color="#21262D" />
            <SolidColorBrush x:Key="AppBorder" Color="#30363D" />
            <SolidColorBrush x:Key="AppTextPrimary" Color="#E6EDF3" />
            <SolidColorBrush x:Key="AppTextMuted" Color="#8B949E" />
            <SolidColorBrush x:Key="AppAccent" Color="#8B5CF6" />
            <SolidColorBrush x:Key="AppAccentPressed" Color="#6D28D9" />
            <SolidColorBrush x:Key="AppAccentHover" Color="#7C3AED" />
            <SolidColorBrush x:Key="AppUserBubble" Color="#2D3B9E" />
            <SolidColorBrush x:Key="AppDanger" Color="#F87171" />
            <SolidColorBrush x:Key="AppDangerHover" Color="#3F1515" />
            <SolidColorBrush x:Key="AppDangerPressed" Color="#5A1E1E" />
            <SolidColorBrush x:Key="AppDisabled" Color="#4B5563" />
            <SolidColorBrush x:Key="AppTextDark" Color="#212620" />
        </ResourceDictionary>
    </Application.Resources>
</Application>