	<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
	  <PackageReference Include="Microsoft.Extensions.Hosting" />
	<PackageReference Include="Microsoft.Extensions.Logging" />
	<PackageReference Include="MarkdownViewer.Wpf" />
	<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	<PackageReference Include="Microsoft.Extensions.Logging.Console" />
	<ProjectReference Include="..\SentinelCore.Orchestrations\SentinelCore.Orchestrations.csproj" />
	<ProjectReference Include="..\SentinelCore.Contracts\SentinelCore.Contracts.csproj" />
	<ProjectReference Include="..\SentinelCore.CaseFlowEngine\SentinelCore.CaseFlowEngine.csproj" />
  </ItemGroup>




