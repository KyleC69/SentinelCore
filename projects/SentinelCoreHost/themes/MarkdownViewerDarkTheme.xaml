<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MarkdownViewer.Wpf.Controls;assembly=MarkdownViewer.Wpf">

    <!--
      MarkdownViewer.Wpf does not actually ship DarkTheme.xaml / LightTheme.xaml
      despite what its README claims. The assembly only embeds themes/generic.baml,
      which contains the default MarkdownView control template, not code-block styles.
      Therefore this project dictionary defines the keyed base styles that the
      CodeBlocksOverrides.xaml file extends via BasedOn.
    -->

    <!-- ====== Code-block palette ====== -->
    <SolidColorBrush x:Key="MarkdownCodeBlockBackground" Color="#161B22" />
    <SolidColorBrush x:Key="MarkdownCodeBlockBorderBrush" Color="#30363D" />
    <SolidColorBrush x:Key="MarkdownCodeBlockHeaderBackground" Color="#21262D" />
    <SolidColorBrush x:Key="MarkdownCodeBlockForeground" Color="#E6EDF3" />
    <SolidColorBrush x:Key="MarkdownCodeBlockMutedForeground" Color="#8B949E" />
    <SolidColorBrush x:Key="MarkdownCodeBlockAccentBrush" Color="#8B5CF6" />

    <!-- ====== Base keyed styles used by CodeBlocksOverrides.xaml ====== -->

    <Style x:Key="CodeBlockBorderStyle" TargetType="controls:CodeBlockBorder">
        <Setter Property="Background" Value="{StaticResource MarkdownCodeBlockBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource MarkdownCodeBlockBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="0,8" />
    </Style>

    <Style x:Key="CodeBlockHeaderBorderStyle" TargetType="controls:CodeBlockHeaderBorder">
        <Setter Property="Background" Value="{StaticResource MarkdownCodeBlockHeaderBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource MarkdownCodeBlockBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="CodeBlockHeaderTextBlockStyle" TargetType="controls:CodeBlockHeaderTextBlock">
        <Setter Property="Foreground" Value="{StaticResource MarkdownCodeBlockMutedForeground}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="CodeBlockCopyButtonStyle" TargetType="controls:CodeBlockCopyButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MarkdownCodeBlockMutedForeground}" />
        <Setter Property="BorderBrush" Value="{StaticResource MarkdownCodeBlockBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:CodeBlockCopyButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{StaticResource MarkdownCodeBlockHeaderBackground}" />
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{StaticResource MarkdownCodeBlockAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CodeBlockTextBlockStyle" TargetType="controls:CodeBlockTextBlock">
        <Setter Property="Foreground" Value="{StaticResource MarkdownCodeBlockForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12" />
    </Style>

</ResourceDictionary>