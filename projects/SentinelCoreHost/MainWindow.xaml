<Window x:Class="SentinelCoreHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mdv="clr-namespace:MarkdownViewer.Wpf;assembly=MarkdownViewer.Wpf"
        xmlns:mdvctrl="clr-namespace:MarkdownViewer.Wpf.Controls;assembly=MarkdownViewer.Wpf"
        xmlns:converters="clr-namespace:SentinelCoreHost.Converters"
        xmlns:models="clr-namespace:Microsoft.Extensions.AI;assembly=Microsoft.Extensions.AI.Abstractions"
        mc:Ignorable="d"
        Title="SentinelCore"
        Height="760" Width="1060"
        MinHeight="520" MinWidth="660"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI">

    <Window.Resources>


        <ResourceDictionary>

            <!-- ── Converters ──────────────────────────────────────────────── -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:PercentageWidthConverter x:Key="PercentageWidthConverter" />
            <!-- ── Base MarkdownView style (hardens rendering/layout) ─────────── -->
            <Style TargetType="{x:Type mdv:MarkdownView}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>


            <Style TargetType="mdvctrl:CodeBlockTextBlock">
                <Setter Property="Background" Value="DarkGray" />
                <Setter Property="Foreground" Value="Black" />
            </Style>
            <Style TargetType="mdvctrl:CodeBlockHeaderBorder">
                <Setter Property="Background" Value="Silver" />
            </Style>

            <!-- ── Message DataTemplate ──────────────────────────────────────── -->
            <!-- One MarkdownView per ChatMessage, role styling via DataTriggers. -->
            <DataTemplate DataType="{x:Type models:ChatMessage}">
                <Border Name="ChatBubble"
                        Margin="0,5"
                        Padding="14,10"

                        HorizontalAlignment="Stretch"
                        Background="{StaticResource AppSurface2}"
                        BorderBrush="{StaticResource AppBorder}"
                        BorderThickness="1"
                        CornerRadius="12,12,12,12">
                    <Border.MaxWidth>
                        <Binding Path="ActualWidth"
                                 RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}, AncestorLevel=1}"
                                 Converter="{StaticResource PercentageWidthConverter}"
                                 ConverterParameter="0.8" />
                    </Border.MaxWidth>
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="Background" Value="{StaticResource AppSurface2}" />
                            <Setter Property="BorderBrush" Value="{StaticResource AppBorder}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Role.User}" Value="True">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Background" Value="{StaticResource AppUserBubble}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource AppUserBubble}" />
                                    <Setter Property="CornerRadius" Value="12,12,2,12" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Role.Assistant}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AppSurface}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource AppAccent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Role.System}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AppSurface2}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource AppDanger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>


                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextMuted}"
                                   FontSize="11"
                                   Text="{Binding Role}" />
                        <mdv:MarkdownView x:Name="MessageMarkdown"
                                          Margin="0,6,0,0"
                                          Foreground="{StaticResource AppTextPrimary}"
                                          Markdown="{Binding Text}"
                                          IsHitTestVisible="True"
                                          IsEnabled="True"
                                          IsManipulationEnabled="True"
                                          HorizontalAlignment="Stretch"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Auto"
                                          WordWrap="True" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- ── Button Styles ───────────────────────────────────────────── -->

            <!-- Send: filled violet, rounded, hover / pressed / disabled states -->
            <Style x:Key="SendButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AppAccent}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="22,0" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background"
                                            Value="{StaticResource AppAccentHover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background"
                                            Value="{StaticResource AppAccentPressed}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Background"
                                            Value="{StaticResource AppDisabled}" />
                                    <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Cancel: outlined red, hidden when not busy -->
            <Style x:Key="CancelButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource AppDanger}" />
                <Setter Property="BorderBrush" Value="{StaticResource AppDanger}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background"
                                            Value="{StaticResource AppDangerHover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Background"
                                            Value="{StaticResource AppDangerPressed}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- TextBox: transparent body, violet caret, renders inside a Border -->
            <Style x:Key="ChatInputStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource AppTextPrimary}" />
                <Setter Property="CaretBrush" Value="{StaticResource AppAccent}" />
                <Setter Property="SelectionBrush" Value="{StaticResource AppAccent}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="SpellCheck.IsEnabled" Value="True" />
                <Setter Property="Language" Value="en-US" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MaxLines" Value="6" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <!-- PART_ContentHost is the required named scroll host for TextBox. -->
                            <!-- Keeping it as a ScrollViewer preserves all TextBox features    -->
                            <!-- including the SpellCheck red-underline adorner layer.          -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          Focusable="False" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════════════════
         Layout: Header | Messages | Input
    ════════════════════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />    <!-- Header bar        -->
            <RowDefinition Height="*" />     <!-- Message feed      -->
            <RowDefinition Height="Auto" />  <!-- Input / actions   -->
            <RowDefinition Height="Auto" />  <!-- Telemetry panel   -->
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="{StaticResource AppSurface}"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource AppBorder}">
            <Grid Margin="20,0">
                <!-- App name + status dot -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9"
                             Fill="{StaticResource AppAccent}"
                             Margin="0,0,10,0" />
                    <TextBlock Text="SentinelCore"
                               Foreground="{StaticResource AppTextPrimary}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Busy indicator in header -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsBusy,
                                         Converter={StaticResource BoolToVisibility}}">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource AppAccent}" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.2" Duration="0:0:0.8" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="Generating…"
                               Foreground="{StaticResource AppTextMuted}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Message Feed ────────────────────────────────────────────────── -->
        <ListBox x:Name="MessagesListBox"
                 Grid.Row="1"
                 Margin="15,0"
                 BorderThickness="0"
                 Background="{StaticResource AppBackground}"
                 ItemsSource="{Binding Messages}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.CanContentScroll="False"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />


        <!-- ── Input Area ──────────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{StaticResource AppSurface}"
                BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource AppBorder}"
                Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- TextBox wrapper: provides the visible border + background -->
                <Border Grid.Row="0"
                        Grid.Column="0"
                        Background="{StaticResource AppSurface2}"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{StaticResource AppBorder}"
                        Margin="0,0,8,0">
                    <Grid>
                        <!-- Spellcheck-enabled, multiline input -->
                        <TextBox x:Name="InputBox"
                                 Style="{StaticResource ChatInputStyle}"
                                 Text="{Binding InputText,
                                        UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="InputBox_KeyDown"
                                 MinHeight="40"
                                 MaxHeight="130"
                                 VerticalContentAlignment="Top" />

                        <!-- Placeholder overlay: hidden as soon as text is present -->
                        <TextBlock Text="Type a message…  (Enter to send · Shift+Enter for new line)"
                                   Foreground="{StaticResource AppTextMuted}"
                                   FontSize="14"
                                   Margin="12,9,12,9"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InputText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Cancel: only meaningful while a response is streaming -->
                <Button Grid.Row="0"
                        Grid.Column="1"
                        Content="Cancel"
                        Style="{StaticResource CancelButtonStyle}"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        Margin="0,0,8,0" />

                <!-- Send -->
                <Button Grid.Row="0"
                        Grid.Column="2"
                        Content="Send  →"
                        Style="{StaticResource SendButtonStyle}"
                        Command="{Binding SendCommand}" />

                <!-- Busy progress bar (reliable pattern from reference app) -->
                <ProgressBar Grid.Row="1"
                             Grid.Column="0"
                             Grid.ColumnSpan="3"
                             Margin="0,8,0,0"
                             Height="3"
                             HorizontalAlignment="Stretch"
                             IsIndeterminate="True"
                             Foreground="{StaticResource AppAccent}"
                             Background="Transparent">
                    <ProgressBar.Style>
                        <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Background="{StaticResource AppSurface2}"
                BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource AppBorder}"
                Padding="16,10">
            <StackPanel>
                <TextBlock Text="Investigation Trace"
                           Foreground="{StaticResource AppTextPrimary}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Active Case"
                               Foreground="{StaticResource AppTextMuted}"
                               FontSize="12"
                               Margin="0,0,12,4" />
                    <TextBlock Grid.Row="0" Grid.Column="1"

                               Foreground="{StaticResource AppTextPrimary}"
                               FontSize="12"
                               TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Plan State"
                               Foreground="{StaticResource AppTextMuted}"
                               FontSize="12"
                               Margin="0,0,12,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1"

                               Foreground="{StaticResource AppTextPrimary}"
                               FontSize="12"
                               TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Dispatched Agents"
                               Foreground="{StaticResource AppTextMuted}"
                               FontSize="12"
                               Margin="0,0,12,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1"

                               Foreground="{StaticResource AppTextPrimary}"
                               FontSize="12"
                               TextWrapping="Wrap" />

                    <TextBlock Grid.Row="3" Grid.Column="0"
                               Text="Confidence"
                               Foreground="{StaticResource AppTextMuted}"
                               FontSize="12"
                               Margin="0,0,12,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1"

                               Foreground="{StaticResource AppTextPrimary}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Grid>
                <TextBlock Text="Final Findings"
                           Foreground="{StaticResource AppTextMuted}"
                           FontSize="12"
                           Margin="0,8,0,2" />
                <TextBlock Text=""
                           Foreground="{StaticResource AppTextPrimary}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

    </Grid>
</Window>