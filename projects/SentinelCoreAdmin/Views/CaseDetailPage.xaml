<Page
    x:Class="SentinelCoreAdmin.Views.CaseDetailPage"
    Style="{DynamicResource MahApps.Styles.Page}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:properties="clr-namespace:SentinelCoreAdmin.Properties"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="900">
    <Page.Resources>
    </Page.Resources>
    <ScrollViewer>
        <Grid Margin="{StaticResource MediumLeftTopRightBottomMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Page Title -->
            <TextBlock
                Grid.Row="0"
                Style="{StaticResource PageTitleStyle}"
                Text="{x:Static properties:Resources.CaseDetailPageTitle}" />

            <!-- Form -->
            <StackPanel Grid.Row="1" Margin="{StaticResource MediumLeftRightMargin}" Width="500"
                        HorizontalAlignment="Left">
                <TextBlock
                    Style="{StaticResource SubtitleTextStyle}"
                    Margin="{StaticResource SmallTopMargin}"
                    Text="Case ID" />
                <TextBox
                    Text="{Binding CaseIdText, UpdateSourceTrigger=PropertyChanged}"
                    Margin="{StaticResource XSmallTopMargin}" />

                <Button
                    Command="{Binding LookupCaseCommand}"
                    Style="{StaticResource MahApps.Styles.Button}"
                    Margin="{StaticResource SmallTopMargin}"
                    Padding="12,4"
                    Content="Look Up" />

                <TextBlock
                    Style="{StaticResource BodyTextStyle}"
                    Margin="{StaticResource SmallTopMargin}"
                    Text="{Binding StatusInfo}" />

                <TextBlock
                    Style="{StaticResource SubtitleTextStyle}"
                    Margin="{StaticResource SmallTopMargin}"
                    Text="Advance To Status" />
                <ComboBox
                    ItemsSource="{Binding AvailableStatuses}"
                    SelectedItem="{Binding SelectedTargetStatus}"
                    Margin="{StaticResource XSmallTopMargin}"
                    Width="250"
                    HorizontalAlignment="Left" />

                <StackPanel Orientation="Horizontal" Margin="{StaticResource SmallTopMargin}">
                    <Button
                        Command="{Binding AdvanceCaseCommand}"
                        Style="{StaticResource MahApps.Styles.Button}"
                        Margin="0,0,12,0"
                        Padding="16,6"
                        Content="Advance Case" />
                    <Button
                        Command="{Binding ClearFormCommand}"
                        Style="{StaticResource MahApps.Styles.Button}"
                        Padding="16,6"
                        Content="Clear" />
                </StackPanel>

                <!-- Result message -->
                <TextBlock
                    Margin="{StaticResource SmallTopMargin}"
                    Style="{StaticResource BodyTextStyle}"
                    Text="{Binding ResultMessage}"
                    Visibility="{Binding ResultVisibility}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>