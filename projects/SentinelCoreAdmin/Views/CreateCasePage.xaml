<Page
    x:Class="SentinelCoreAdmin.Views.CreateCasePage"
    Style="{DynamicResource MahApps.Styles.Page}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:properties="clr-namespace:SentinelCoreAdmin.Properties"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="900">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>
    <ScrollViewer>
        <Grid Margin="{StaticResource MediumLeftTopRightBottomMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Page Title -->
            <TextBlock
                Grid.Row="0"
                Style="{StaticResource PageTitleStyle}"
                Text="{x:Static properties:Resources.CreateCasePageTitle}" />

            <!-- Form -->
            <StackPanel Grid.Row="1" Margin="{StaticResource MediumLeftRightMargin}" Width="500" HorizontalAlignment="Left">
                <TextBlock
                    Style="{StaticResource SubtitleTextStyle}"
                    Margin="{StaticResource SmallTopMargin}"
                    Text="Signal Description" />
                <TextBox
                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                    Margin="{StaticResource XSmallTopMargin}"
                    MinHeight="80"
                    TextWrapping="Wrap"
                    AcceptsReturn="True"
                    VerticalScrollBarVisibility="Auto" />

                <TextBlock
                    Style="{StaticResource SubtitleTextStyle}"
                    Margin="{StaticResource SmallTopMargin}"
                    Text="Signal Source" />
                <TextBox
                    Text="{Binding SignalSource, UpdateSourceTrigger=PropertyChanged}"
                    Margin="{StaticResource XSmallTopMargin}" />

                <StackPanel Orientation="Horizontal" Margin="{StaticResource SmallTopMargin}">
                    <Button
                        Command="{Binding CreateCaseCommand}"
                        Style="{StaticResource MahApps.Styles.Button}"
                        Margin="0,0,12,0"
                        Padding="16,6"
                        Content="Create Case" />
                    <Button
                        Command="{Binding ResetFormCommand}"
                        Style="{StaticResource MahApps.Styles.Button}"
                        Padding="16,6"
                        Content="Reset" />
                </StackPanel>

                <!-- Result message -->
                <TextBlock
                    Margin="{StaticResource SmallTopMargin}"
                    Style="{StaticResource BodyTextStyle}"
                    TextWrapping="Wrap"
                    Text="{Binding ResultMessage}"
                    Visibility="{Binding ResultVisibility}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>