<Page
    x:Class="SentinelCoreAdmin.Views.CaseListPage"
    Style="{DynamicResource MahApps.Styles.Page}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:properties="clr-namespace:SentinelCoreAdmin.Properties"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="900">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>
    <Grid Margin="{StaticResource MediumLeftTopRightBottomMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Title -->
        <TextBlock
            Grid.Row="0"
            Style="{StaticResource PageTitleStyle}"
            Text="{x:Static properties:Resources.CaseListPageTitle}" />

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="{StaticResource SmallTopBottomMargin}">
            <Button
                Command="{Binding LoadCasesCommand}"
                Style="{StaticResource MahApps.Styles.Button}"
                Margin="0,0,8,0"
                Padding="12,4"
                Content="Refresh" />
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextStyle}"
                Margin="8,0,4,0"
                Text="Filter by status:" />
            <ComboBox
                ItemsSource="{Binding AvailableStatuses}"
                SelectedItem="{Binding SelectedStatusFilter}"
                Width="160"
                Margin="4,0" />
            <Button
                Command="{Binding FilterByStatusCommand}"
                Style="{StaticResource MahApps.Styles.Button}"
                Margin="4,0,8,0"
                Padding="8,4"
                Content="Apply" />
            <Button
                Command="{Binding ClearFilterCommand}"
                Style="{StaticResource MahApps.Styles.Button}"
                Padding="8,4"
                Content="Clear" />
        </StackPanel>

        <!-- Case Summary DataGrid (visible when not drilled down) -->
        <DataGrid
            Grid.Row="2"
            ItemsSource="{Binding Cases}"
            SelectedItem="{Binding SelectedCase}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            CanUserSortColumns="True"
            CanUserResizeColumns="True"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            BorderBrush="{DynamicResource MahApps.Brushes.Controls.Border}"
            BorderThickness="1"
            Visibility="{Binding IsDrilledDown, Converter={StaticResource InvertBoolToVisibility}}"
            MouseDoubleClick="SummaryDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" />
                <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Drill-down detail panel (visible when drilled down) -->
        <Grid Grid.Row="2" Visibility="{Binding IsDrilledDown, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="{StaticResource SmallTopBottomMargin}">
                <Button
                    Command="{Binding GoBackToSummaryCommand}"
                    Style="{StaticResource MahApps.Styles.Button}"
                    Margin="0,0,8,0"
                    Padding="8,4"
                    Content="&#x2190; Back to Summary" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyTextStyle}"
                    Text="{Binding DrillDownHeader}" />
            </StackPanel>

            <DataGrid
                Grid.Row="1"
                ItemsSource="{Binding DetailCases}"
                SelectedItem="{Binding SelectedDetailCase}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserSortColumns="True"
                CanUserResizeColumns="True"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                BorderBrush="{DynamicResource MahApps.Brushes.Controls.Border}"
                BorderThickness="1"
                MouseDoubleClick="DetailDataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Case ID" Binding="{Binding CaseId}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=g}" Width="180" />
                    <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAt, StringFormat=g}" Width="180" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>