using Microsoft.Agents.AI;
using Microsoft.Agents.AI.Workflows;
using Microsoft.Agents.AI.Workflows.Specialized.Magentic;
using Microsoft.Extensions.AI;
using Microsoft.Extensions.Logging;

using SentinelCoreLib.Agents.Domain;
using SentinelCoreLib.Agents.Dynamic;
using SentinelCoreLib.Agents.Manager;
using SentinelCoreLib.Application;
using SentinelCoreLib.Contracts;
using SentinelCoreLib.Tools;
using System.Text;
using System.Text.Json;




namespace SentinelCoreLib.Orchestration;





/// <summary>
///     Represents a sealed orchestrator responsible for executing investigation plans
///     through the Magnetic workflow. This class integrates with various agent factories
///     to facilitate dynamic, domain-specific, and manager-level operations.
/// </summary>
/// <remarks>
///     The <see cref="MagneticOrchestrator" /> is designed to handle structured investigation
///     plans and synthesize results through its execution pipeline. It is registered as a
///     singleton service in the dependency injection container and is a core component of
///     the SentinelCore orchestration layer.
/// </remarks>
public sealed class MagneticOrchestrator
{
    private readonly DomainAgentFactory _domainAgentFactory;
    private readonly DynamicAgentFactory _dynamicAgentFactory;
    private readonly ILogger<MagneticOrchestrator> _logger;

    private readonly ManagerAgentFactory _managerAgentFactory;

    private static readonly JsonSerializerOptions s_jsonOptions = new(JsonSerializerDefaults.Web) { PropertyNameCaseInsensitive = true };







    /// <summary>
    ///     Initializes a new instance of the <see cref="MagneticOrchestrator" /> class.
    /// </summary>
    public MagneticOrchestrator(ManagerAgentFactory managerAgentFactory, DomainAgentFactory domainAgentFactory, DynamicAgentFactory dynamicAgentFactory, ILogger<MagneticOrchestrator> logger)
    {
        _managerAgentFactory = managerAgentFactory ?? throw new ArgumentNullException(nameof(managerAgentFactory));
        _domainAgentFactory = domainAgentFactory ?? throw new ArgumentNullException(nameof(domainAgentFactory));
        _dynamicAgentFactory = dynamicAgentFactory ?? throw new ArgumentNullException(nameof(dynamicAgentFactory));
        _logger = logger ?? throw new ArgumentNullException(nameof(logger));
    }








    /// <summary>
    ///     Builds the execution prompt for the Magentic workflow based on the supplied investigation plan and optional case
    ///     identifier.
    ///     Each line(step) of the plan is one task and carries with it the information needed to execute the task.
    ///     We need to extract the properties of each step and pass them into prompt templates for each domain agent to
    ///     execute. The prompt should be structured in a way that clearly communicates the tasks to be performed, the expected
    ///     output format, and any relevant context or constraints.
    ///     TODO: craft prompt template when plan shape is finalized.
    /// </summary>
    /// <param name="plan">The investigation plan to execute.</param>
    /// <param name="caseId">An optional case identifier.</param>
    /// <returns>A string containing the execution prompt.</returns>
    internal string BuildExecutionPrompt(InvestigationPlan plan, string? caseId)
    {
        //From poco to json, is this necessary?
        string payload = JsonSerializer.Serialize(plan, s_jsonOptions);
        StringBuilder builder = new();

        builder.AppendLine("Execute this SentinelCore investigation plan using the Magentic workflow.");

        if (!string.IsNullOrWhiteSpace(caseId))
        {
            builder.Append("CaseId: ").Append(caseId).AppendLine();
        }

        builder.AppendLine("Return a single JSON object that matches the InvestigationResult contract.");
        builder.AppendLine("Plan:");
        builder.AppendLine(payload);

        return builder.ToString();
    }








    /// <summary>
    ///     Constructs a list of AI agents (participants) required for executing the specified
    ///     <see cref="InvestigationPlan" />. This includes domain agents and, if necessary, a dynamic agent.
    /// </summary>
    /// <param name="plan">
    ///     The <see cref="InvestigationPlan" /> that defines the steps and requirements for the investigation.
    /// </param>
    /// <returns>
    ///     A list of <see cref="AIAgent" /> instances representing the participants in the Magnetic workflow.
    /// </returns>
    /// <remarks>
    ///     The method evaluates the steps in the provided <see cref="InvestigationPlan" /> to determine
    ///     the required domain agents. If any step specifies a composite agent or requires dynamic behavior,
    ///     a dynamic agent is also created and added to the participants list.
    /// </remarks>
    /// <exception cref="ArgumentNullException">
    ///     Thrown if the <paramref name="plan" /> is <c>null</c>.
    /// </exception>
    private List<AIAgent> BuildParticipants(InvestigationPlan plan)
    {
        if (plan == null)
        {
            throw new ArgumentNullException(nameof(plan));
        }

        List<AIAgent> participants = [];
        HashSet<string> participantNames = new(StringComparer.OrdinalIgnoreCase);
        bool useDynamicAgent = false;
        HashSet<string> dynamicToolNames = new(StringComparer.OrdinalIgnoreCase);

        foreach (InvestigationPlanStep step in plan.Steps)
        {
            if (TryCreateDomainAgent(step.Surface, participants, participantNames))
            {
                continue;
            }

            useDynamicAgent = true;


        }



        if (useDynamicAgent || dynamicToolNames.Count > 0)
        {
            participants.Add(_dynamicAgentFactory.Create("dynamic_agent", "You are the dynamic composite agent in the SentinelCore magnetic orchestration workflow. Use only the tools assigned for this run, correlate cross-domain evidence, and return a bounded structured result.", dynamicToolNames.Count > 0 ? dynamicToolNames.ToList() : new List<string>()));
        }

        return participants;
    }








    internal Workflow BuildWorkflow(InvestigationPlan plan)
    {
        //create the manager agent and the domain agents required for the investigation plan. If any of the steps in the plan require a dynamic agent, create one as well. Then build the Magentic workflow with the manager and participants.
        AIAgent manager = _managerAgentFactory.Create();

        //Build the list of participants based on the investigation plan. This includes domain agents and, if required, a dynamic agent.
        List<AIAgent> participants = BuildParticipants(plan);


        bool requiresDynamicAgent = plan.Steps.Any(step => string.Equals(step.Surface, "composite_agent", StringComparison.OrdinalIgnoreCase));



        if (requiresDynamicAgent)
        {

            participants.Add(_dynamicAgentFactory.Create("dynamic_agent", "You are the dynamic composite agent in the SentinelCore magnetic orchestration workflow. Use only the tools assigned for this run, correlate cross-domain evidence, and return a bounded structured result.", []));

        }

        return new MagenticWorkflowBuilder(manager).AddParticipants(participants).WithName("SentinelCore Magnetic Orchestration").WithDescription("Coordinates SentinelCore domain and dynamic agents to execute a structured investigation plan.").RequirePlanSignoff(false).WithMaxRounds(Math.Max(1, plan.Steps.Count * 2)).WithMaxStalls().WithMaxResets(2).Build();
    }








    private static InvestigationPlan CreateResult(string responseText, string? caseId)
    {
        if (!string.IsNullOrWhiteSpace(responseText))
        {
            try
            {
                InvestigationPlan? result = JsonSerializer.Deserialize<InvestigationPlan>(responseText, s_jsonOptions);
                if (result is not null)
                {
                    if (string.IsNullOrWhiteSpace(result.CaseId))
                    {
                        result.CaseId = caseId ?? string.Empty;
                    }

                    return result;
                }
            }
            catch (JsonException)
            {
                // Fall back to a textual result when the manager returns a non-JSON summary.
            }
        }

        return new InvestigationPlan { CaseId = caseId ?? string.Empty };
    }








    /// <summary>
    ///     Executes the supplied investigation plan through the Magentic workflow.
    /// </summary>
    /// <param name="plan">The structured investigation plan produced by the Core agent.</param>
    /// <param name="caseId">Optional case identifier to stamp into the returned result.</param>
    /// <param name="cancellationToken">Cancellation token.</param>
    /// <returns>The structured investigation result synthesized by the manager.</returns>
    public Task<InvestigationPlan> ExecuteAsync(InvestigationPlan plan, string? caseId = null, CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(plan);
        ArgumentNullException.ThrowIfNull(plan.Steps);

        return ExecuteCoreAsync(plan, caseId, cancellationToken);
    }








    /// <summary>
    ///     Executes the supplied investigation plan through the Magentic workflow.
    ///     It is critical that this orchestration be as flexible as possible to allow for dynamic agent participation,
    ///     cross-domain evidence correlation, and structured result synthesis.
    ///     It is also critical that the orchestration be able to monitor and handle stalling, looping, and replanning
    ///     scenarios gracefully.
    ///     It is impossible to know in advance which domains will be required for a given investigation plan, so the
    ///     orchestration must be able to dynamically spawn and manage domain agents as needed.
    /// </summary>
    /// <param name="plan">The structured investigation plan produced by the Core agent.</param>
    /// <param name="caseId">Optional case identifier to stamp into the returned result.</param>
    /// <param name="cancellationToken">Cancellation token.</param>
    /// <returns>The structured investigation result synthesized by the manager.</returns>
    internal async Task<InvestigationPlan> ExecuteCoreAsync(InvestigationPlan plan, string? caseId, CancellationToken cancellationToken)
    {

        string taskPrompt = "You are the manager agent in the SentinelCore magnetic orchestration workflow. You are responsible for coordinating the execution of a structured investigation plan, which consists of multiple steps that may require different domain agents or a dynamic composite agent. Your task is to ensure that each step is executed correctly, that progress is monitored, and that any issues such as stalling or looping are handled appropriately. You will receive updates from the participating agents and must synthesize their responses into a final structured result that adheres to the InvestigationResult contract.";


        //Dynamically build the Magentic workflow based on the supplied investigation plan and the required domain agents.

        Workflow workflow = BuildWorkflow(plan);

        //
        string prompt = BuildExecutionPrompt(plan, caseId);



        await using StreamingRun run = await InProcessExecution.RunStreamingAsync(workflow, new List<ChatMessage> { new(ChatRole.User, taskPrompt) }, cancellationToken: cancellationToken);

        await run.TrySendMessageAsync(new TurnToken(true));

        string? lastResponseId = null;
        WorkflowOutputEvent? finalOutput = null;

        await foreach (WorkflowEvent workflowEvent in run.WatchStreamAsync(cancellationToken))
            switch (workflowEvent)
            {
                case AgentResponseUpdateEvent updateEvent:
                    // Stream per-participant deltas. Group by ResponseId / MessageId / ExecutorId so
                    // each new contiguous response logs its executor header once.
                    string responseId = updateEvent.Update.ResponseId ?? updateEvent.Update.MessageId ?? updateEvent.ExecutorId;
                    if (!string.Equals(responseId, lastResponseId, StringComparison.Ordinal))
                    {
                        _logger.LogTrace("Agent activity - {ExecutorId}:", updateEvent.ExecutorId);
                        lastResponseId = responseId;
                    }

                    _logger.LogTrace("{UpdateText}", updateEvent.Update.Text);
                    break;

                case MagenticPlanCreatedEvent planCreated:
                    _logger.LogTrace("[Magentic Initial Plan]\n{PlanText}", planCreated.FullTaskLedger.Text);
                    break;

                case MagenticReplannedEvent replanned:
                    _logger.LogTrace("[Magentic Replanned]\n{PlanText}", replanned.FullTaskLedger.Text);
                    break;

                case MagenticProgressLedgerUpdatedEvent progressUpdated:
                    MagenticProgressLedger ledger = progressUpdated.ProgressLedger;
                    _logger.LogTrace("[Magentic Progress Ledger] satisfied={IsRequestSatisfied}, " + "inLoop={IsInLoop}, progressing={IsProgressBeingMade}, " + "nextSpeaker={NextSpeaker}, instruction={InstructionOrQuestion}", ledger.IsRequestSatisfied, ledger.IsInLoop, ledger.IsProgressBeingMade, ledger.NextSpeaker, ledger.InstructionOrQuestion);
                    break;

                case WorkflowOutputEvent outputEvent when outputEvent.Is<List<ChatMessage>>():
                    finalOutput = outputEvent;
                    break;

                case WorkflowErrorEvent workflowError:
                    _logger.LogError(workflowError.Exception, "Workflow error occurred.");
                    break;

                case ExecutorFailedEvent executorFailed:
                    _logger.LogError("Executor '{ExecutorId}' failed: {Error}", executorFailed.ExecutorId, executorFailed.Data?.ToString() ?? "unknown error");
                    break;
            }

        if (finalOutput is null)
        {
            throw new InvalidOperationException("Workflow completed without producing a final output.");
        }

        List<ChatMessage>? messages = finalOutput.Data as List<ChatMessage>;
        string responseText = ExtractText(messages);

        return CreateResult(responseText, caseId);
    }








    private static string ExtractText(List<ChatMessage>? messages)
    {
        if (messages is null || messages.Count == 0)
        {
            return string.Empty;
        }

        IEnumerable<string> text = messages.SelectMany(message => message.Contents.OfType<TextContent>().Select(content => content.Text)).Where(segment => !string.IsNullOrWhiteSpace(segment));

        return string.Join(Environment.NewLine, text);
    }


private bool IsDuplicateParticipant(AIAgent participant, HashSet<string> participantNames)
{
    return participantNames.Contains(participant.Name);
}

private void LogAgentCreationFailure(string domain)
{
    _logger.LogError("Failed to create an agent for domain: {Domain}. Verify the domain configuration.", domain);
}

private bool TryCreateDomainAgent(string domain, List<AIAgent> participants, HashSet<string> participantNames)
{
    if (!ValidateDomain(domain))
    {
        return false;
    }

    AIAgent? participant = CreateAgent(domain);
    if (participant == null || IsDuplicateParticipant(participant, participantNames))
    {
        return false;
    }

    participants.Add(participant);
    participantNames.Add(participant.Name);
    return true;
}

private bool ValidateDomain(string domain)
{
    if (string.IsNullOrWhiteSpace(domain))
    {
        LogInvalidDomain(domain);
        return false;
    }

    return true;
}

private AIAgent? CreateAgent(string domain)
{
    AIAgent? participant = _domainAgentFactory.CreateAgent(domain, ToolRegistry.GetToolByDomain(domain) ,"You are a domain agent in the SentinelCore magnetic orchestration workflow. Your task is to execute investigation steps related to the specified domain, gather relevant information, and return structured results. Follow the instructions provided in each step and ensure that your responses adhere to the expected output format.");
    if (participant == null)
    {
        LogAgentCreationFailure(domain);
    }

    return participant;
}

private void LogInvalidDomain(string domain)
{
    Log(LogLevel.Warning, "Invalid domain provided: {Domain}.", domain);
}

private void Log(LogLevel level, string message, params object[] args)
{
    _logger.Log(level, message, args);
}









}
