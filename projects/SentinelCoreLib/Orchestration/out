        "text": "{\n  \"CaseId\": \"bafa80da-ad51-4523-8cc7-514e847baf31\",\n  \"EvidenceOperations\": [\n    {\n      \"OperationId\": \"op-001\",\n      \"Surface\": \"EventLog\",\n      \"Instruction\": \"Export all System event log entries with Event ID 10016 for the past 48 hours to a .evtx file for later analysis.\",\n      \"Result\": \"\"\n    },\n    {\n      \"OperationId\": \"op-002\",\n      \"Surface\": \"Registry\",\n      \"Instruction\": \"Query the registry key HKCR\\\\CLSID\\\\{6B3B8D23-FA8D-40B9-8DBD-B950333E2C52} and capture its default value, InprocServer32, LocalServer32, and AppID subkeys.\",\n      \"Result\": \"\"\n    },\n    {\n      \"OperationId\": \"op-003\",\n      \"Surface\": \"Registry\",\n      \"Instruction\": \"Query the registry key HKCR\\\\AppID\\\\{4839DDB7-58C2-48F5-8283-E1D1807D0D7D} and capture its default value, RunAs, and DCOM permissions (LaunchPermission and AccessPermission) binary blobs.\",\n      \"Result\": \"\"\n    },\n    {\n      \"OperationId\": \"op-004\",\n      \"Surface\": \"PowerShell\",\n      \"Instruction\": \"Run Get-ItemProperty -Path 'HKLM:\\\\SOFTWARE\\\\Microsoft\\\\Ole' -Name 'EnableDCOM' to verify that DCOM is enabled on the system.\",\n      \"Result\": \"\"\n    },\n    {\n      \"OperationId\": \"op-005\",\n      \"Surface\": \"PowerShell\",\n      \"Instruction\": \"Execute Get-Acl -Path 'HKCR:\\\\AppID\\\\{4839DDB7-58C2-48F5-8283-E1D1807D0D7D}' and export the ACL entries to capture explicit Local Activation permissions for SID S-1-5-19.\",\n      \"Result\": \"\"\n    },\n    {\n      \"OperationId\": \"op-006\",\n      \"Surface\": \"PowerShell\",\n      \"Instruction\": \"Resolve SID S-1-5-19 to its account name using [System.Security.Principal.SecurityIdentifier]::new('S-1-5-19').Translate([System.Security.Principal.NTAccount]) and store the result.\",\n      \"Result\": \"\"\n    },\n    {\n      \"OperationId\": \"op-007\",\n      \"Surface\": \"WMI\",\n      \"Instruction\": \"Query Win32_ComClass where CLSID = '{6B3B8D23-FA8D-40B9-8DBD-B950333E2C52}' to retrieve the associated executable or service name.\",\n      \"Result\": \"\"\n    },\n    {\n      \"OperationId\": \"op-008\",\n      \"Surface\": \"Tasklist\",\n      \"Instruction\": \"List all services and processes running under the Local Service account (NT AUTHORITY\\\\LOCAL SERVICE) and capture their process IDs and executable paths.\",\n      \"Result\": \"\"\n    },\n    {\n      \"OperationId\": \"op-009\",\n      \"Surface\": \"ComponentServices\",\n      \"Instruction\": \"Export the Component Services (DCOMCNFG) configuration for the AppID {4839DDB7-58C2-48F5-8283-E1D1807D0D7D} using the command 'mmc comexp.msc /s' or equivalent scriptable export, capturing the Launch and Activation permission settings.\",\n      \"Result\": \"\"\n    },\n    {\n      \"OperationId\": \"op-010\",\n      \"Surface\": \"SystemInfo\",\n      \"Instruction\": \"Collect the system's OS version, build number, and installed updates list to correlate with known DCOM permission issues.\",\n      \"Result\": \"\"\n    }\n  ]
        